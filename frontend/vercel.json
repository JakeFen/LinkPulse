{
    "rewrites": [
        {
            "source": "/dashboard",
            "destination": "/index.html"
        },
        {
            "source": "/:shortCode",
            "destination": "https://linkpulse-api-wtlm.onrender.com/:shortCode"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}